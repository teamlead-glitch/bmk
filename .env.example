# Copy to .env.local for local development. Set the same keys in Vercel (Production + Preview).

# Site address for canonical URLs, sitemap and robots (production: the live domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container (empty = no tracking scripts)
NEXT_PUBLIC_GTM_ID=

# Mega menu design: "categories" (default) or "brands"
NEXT_PUBLIC_MEGA_MENU=categories

# --- CMS (FAQ is live; other pages still read src/data) ---
# CMS API base (no trailing slash), e.g. https://bmk.phitanydev.in/api
NEXT_PUBLIC_API_URI=
# Server only: sent as X-Frontend-Key; must equal the CMS's key
CMS_API_KEY=
# CMS data cache time in seconds (default 300)
CMS_REVALIDATE_SECONDS=60
# Server only: shared secret for POST /api/revalidate/ (header x-revalidate-secret)
REVALIDATE_SECRET=
# Server only: signs the enquiry forms' CAPTCHA codes (any long random string; falls back to
# REVALIDATE_SECRET / CMS_API_KEY). Must be the same on every server instance.
CAPTCHA_SECRET=

# Google Maps JavaScript API browser key: the live map with a marker per company (About page,
# Our companies). Restrict it in Google Cloud to the site domains (HTTP referrers) and to the Maps
# JavaScript API. Empty: the map still shows, with Google's own auth error on it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

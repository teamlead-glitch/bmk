# Copy to .env.local for local development. Set the same keys in Vercel (Production + Preview).

# Site address for canonical URLs, sitemap and robots (production: the live domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container (empty = no tracking scripts)
NEXT_PUBLIC_GTM_ID=

# Mega menu design: "categories" (default) or "brands"
NEXT_PUBLIC_MEGA_MENU=categories

# --- CMS (not live yet; content comes from src/data until then) ---
# CMS API base, e.g. https://cms.example.com/api
NEXT_PUBLIC_API_URI=
# Server only: sent as X-Frontend-Key; must equal the CMS's key
CMS_API_KEY=
# CMS data cache time in seconds (default 300)
CMS_REVALIDATE_SECONDS=300
# Server only: shared secret for POST /api/revalidate/ (header x-revalidate-secret)
REVALIDATE_SECRET=
